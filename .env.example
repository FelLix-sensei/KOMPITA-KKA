# PostgreSQL connection string from Supabase, Neon, or another hosted PostgreSQL provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional direct connection used by Prisma migrations on pooled providers.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Used once to provision the initial administrator. Change this in Vercel before seeding.
ADMIN_USERNAME="ftnfellix"
ADMIN_INITIAL_PASSWORD="replace-this-before-deploying"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
